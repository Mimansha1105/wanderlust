<% layout('listings/layouts/boilerplate') %>
<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter{
    margin-top: 1.5rem;
    text-align: center;
    margin-right: 2rem;
    opacity: 0.7;
  }
  .filter p{
    font-size: 0.8rem;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }
  .filter a{
    color: inherit;
    text-decoration: none;
  }
  .filter.active{
    opacity: 1;
    border-bottom: 2px solid #222;
  }
  .tax-info{
    display: none;
  }
  .tax-toggle{
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.2rem;
    padding: 0.8rem;
  display: flex;
  align-items: center;
  margin-bottom: 0.5rem;
  }
</style>

<body>
      <!---  <h3>all listings</h3>>
   <!--- <form method="get" action="/listings/new">
  <button> Create new list!</button>
    </form> */-->
    <div id="filters">

<div class="filter <%= categoryQuery === 'trending' ? 'active' : '' %>">
<a href="/listings?category=trending">
<div><i class="fa-solid fa-fire"></i></div>
<p>Trending</p>
</a>
</div>

<div class="filter <%= categoryQuery === 'rooms' ? 'active' : '' %>">
<a href="/listings?category=rooms">
<div><i class="fa-solid fa-bed"></i></div>
<p>Rooms</p>
</a>
</div>

<div class="filter <%= categoryQuery === 'iconic cities' ? 'active' : '' %>">
<a href="/listings?category=iconic%20cities">
<div><i class="fa-solid fa-mountain-city"></i></div>
<p>Iconic citites</p>
</a>
</div>

<div class="filter <%= categoryQuery === 'mountains' ? 'active' : '' %>">
<a href="/listings?category=mountains">
<div><i class="fa-solid fa-mountain"></i></div>
<p>Mountains</p>
</a>
</div>

<div class="filter <%= categoryQuery === 'castles' ? 'active' : '' %>">
<a href="/listings?category=castles">
<div><i class="fa-brands fa-fort-awesome"></i></div>
<p>Castles</p>
</a>
</div>


<div class="filter <%= categoryQuery === 'beaches' ? 'active' : '' %>">
<a href="/listings?category=beaches">
<div><i class="fa-solid fa-umbrella-beach"></i></div>
<p>Beaches</p>
</a>
</div>


<div class="filter <%= categoryQuery === 'lakefronts' ? 'active' : '' %>">
<a href="/listings?category=lakefronts">
<div><i class="fa-solid fa-water"></i></div>
<p>Lakefronts</p>
</a>
</div>


<div class="filter <%= categoryQuery === 'surfing' ? 'active' : '' %>">
<a href="/listings?category=surfing">
<div><i class="fa-solid fa-house-tsunami"></i></div>
<p>Surfing</p>
</a>
</div>


<div class="filter <%= categoryQuery === 'bloosoms' ? 'active' : '' %>">
<a href="/listings?category=bloosoms">
<div><i class="fa-solid fa-fan"></i></div>
<p>Bloosoms</p>
</a>
</div>

<div class="filter <%= categoryQuery === 'camping' ? 'active' : '' %>">
<a href="/listings?category=camping">
<div><i class="fa-solid fa-campground"></i></div>
<p>Camping</p>
</a>
</div>

<div class="filter <%= categoryQuery === 'farms' ? 'active' : '' %>">
<a href="/listings?category=farms">
<div><i class="fa-solid fa-cow"></i></div>
<p>Farms</p>
</a>
</div>

<div class="filter <%= categoryQuery === 'arctic' ? 'active' : '' %>">
<a href="/listings?category=arctic">
<div><i class="fa-solid fa-snowflake"></i></div>
<p>Arctic</p>
</a>
</div>
<div class="filter">


<div class="tax-toggle">
  <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display Total after taxes</label>
</div>
</div>
</div>

    </div>
<% if (alllistings.length === 0) { %>
  <div class="text-center mt-5 mb-5">
    <h3>Not available</h3>
    <% if (searchQuery) { %>
      <p>No hotel found for "<%= searchQuery %>".</p>
    <% } %>
  </div>
<% } else { %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-3 mt-3">
<%for(let listing of alllistings){%>
    <a href="/listings/<%=listing._id%>" class="listing-links">
<div class="card col listing-card" >
<img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">

  <div class="card-img-overlay"></div>



  <div class="card-body">
   <b> <p class="card-text"><%=listing.title%></b><br>
           &#8377; <%=listing.price.toLocaleString ("en-IN")%>/night <i class="tax-info"> &nbsp;&nbsp;+18% GST</i></p>
  </div>
</div>
</a>
<%}%> 

</div>
<% } %>

 

</body>
<script>
  let taxswitch=document.getElementById("switchCheckDefault");
  taxswitch.addEventListener("click",()=>{
 let taxinfo=document.getElementsByClassName("tax-info");
 for(info of taxinfo){
  if(info.style.display!="inline"){
      info.style.display="inline";
  }
  else{
  info.style.display="none";
  }
 }
  });
</script>
